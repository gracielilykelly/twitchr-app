{{> menu id="field-study" isAuthUser=true}}

<div class="page-heading">
  <div><h1>Field study</h1><p>A record of the species observed at your feeder</p></div>
</div>

<section class="section-card field-study-summary">
  <div class="field-study-summary-item"><span class="metric-label">Species observed</span><strong>{{species.length}}</strong></div>
  <div class="field-study-summary-item"><span class="metric-label">Catalogue</span><strong>Birds</strong></div>
  <div class="field-study-summary-item"><span class="metric-label">Updated</span><strong>20 Aug 2026</strong></div>
</section>

<section class="field-study-grid">
  {{#each species}}
  <a class="species-card section-card" href="/field-study/{{slug}}">
    <div class="species-card-image{{#unless image}} species-card-image-empty{{/unless}}">
      {{#if image}}<img src="{{image}}" alt="{{commonName}}">{{else}}<i class="fa fa-feather-pointed" aria-hidden="true"></i>{{/if}}
    </div>
    <div class="species-card-body">
      <span class="metric-label">{{scientificName}}</span>
      <h2>{{commonName}}</h2>
      <p>{{description}}</p>
      <div class="species-card-meta"><span>{{sightings}} sightings</span><span>Last seen {{lastSeen}}</span></div>
    </div>
  </a>
  {{/each}}
</section>
