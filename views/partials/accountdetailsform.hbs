<form action="{{postUrl}}" method="POST">
  <input type="hidden" name="_csrf" value="{{csrfToken}}">
  <section class="section-card settings-section">
    <h2>Profile</h2>
    <p>Contact details used for account access and notifications. Email changes require confirmation before your login address changes.</p>
    <div class="row g-3">
      <div class="col-md-6"><label class="form-label" for="firstname">First name</label><input id="firstname" name="firstName" required type="text" value="{{user.firstName}}" class="form-control"></div>
      <div class="col-md-6"><label class="form-label" for="lastname">Last name</label><input id="lastname" name="lastName" required type="text" value="{{user.lastName}}" class="form-control"></div>
      <div class="col-md-6"><label class="form-label" for="email">Email</label><input id="email" name="email" required type="email" value="{{user.email}}" class="form-control"></div>
      <div class="col-md-6"><label class="form-label" for="phone">Phone number</label><input id="phone" name="phone" required type="tel" value="{{user.phoneNumber}}" class="form-control"></div>
    </div>
  </section>

  <section class="section-card settings-section">
    <h2>Appearance</h2>
    <p>Choose how Twitchr looks on this device.</p>
    <div class="settings-preference-row"><div><label for="themeToggle">Dark mode</label><span>Use a darker colour palette across the app.</span></div><div class="form-check form-switch"><input class="form-check-input" type="checkbox" id="themeToggle"><label class="visually-hidden" for="themeToggle">Enable dark mode</label></div></div>
  </section>

  <section class="section-card settings-section">
    <h2>Notification preferences</h2>
    <p>Choose which events to receive and how they should reach you.</p>
    <div class="notification-grid">
      <div class="notification-row header"><div>Notification</div><div>Enabled</div><div>Email</div><div>SMS</div></div>
      <div class="notification-row"><div><label for="enableBirdNotifications">Bird sightings</label></div><div><div class="form-check form-switch"><input class="form-check-input" type="checkbox" name="enableBirdNotifications" value="true" id="enableBirdNotifications" {{#if user.notificationSettings.bird.receive}}checked{{/if}}></div></div><div><input class="form-check-input" type="checkbox" name="birdEmail" value="email" id="birdEmail" {{#if (includes user.notificationSettings.bird.commTypes 'email')}}checked{{/if}}><label class="visually-hidden" for="birdEmail">Bird sightings by email</label></div><div><input class="form-check-input" type="checkbox" name="birdSMS" value="sms" id="birdSMS" {{#if (includes user.notificationSettings.bird.commTypes 'sms')}}checked{{/if}}><label class="visually-hidden" for="birdSMS">Bird sightings by SMS</label></div></div>
      <div class="notification-row"><div><label for="enableCatNotifications">Cat sightings</label></div><div><div class="form-check form-switch"><input class="form-check-input" type="checkbox" name="enableCatNotifications" value="true" id="enableCatNotifications" {{#if user.notificationSettings.cat.receive}}checked{{/if}}></div></div><div><input class="form-check-input" type="checkbox" name="catEmail" value="email" id="catEmail" {{#if (includes user.notificationSettings.cat.commTypes 'email')}}checked{{/if}}><label class="visually-hidden" for="catEmail">Cat sightings by email</label></div><div><input class="form-check-input" type="checkbox" name="catSMS" value="sms" id="catSMS" {{#if (includes user.notificationSettings.cat.commTypes 'sms')}}checked{{/if}}><label class="visually-hidden" for="catSMS">Cat sightings by SMS</label></div></div>
      {{#if user.isAdmin}}
      <div class="notification-row"><div><label for="enableWeatherNotifications">Weather alerts</label></div><div><div class="form-check form-switch"><input class="form-check-input" type="checkbox" name="enableWeatherNotifications" value="true" id="enableWeatherNotifications" {{#if user.notificationSettings.weather.receive}}checked{{/if}}></div></div><div><input class="form-check-input" type="checkbox" name="weatherEmail" value="email" id="weatherEmail" {{#if (includes user.notificationSettings.weather.commTypes 'email')}}checked{{/if}}><label class="visually-hidden" for="weatherEmail">Weather alerts by email</label></div><div><input class="form-check-input" type="checkbox" name="weatherSMS" value="sms" id="weatherSMS" {{#if (includes user.notificationSettings.weather.commTypes 'sms')}}checked{{/if}}><label class="visually-hidden" for="weatherSMS">Weather alerts by SMS</label></div></div>
      {{/if}}
    </div>
  </section>

  {{#if user.isAdmin}}
  <section class="section-card settings-section">
    <h2>Device location</h2>
    <p>Used for local weather information.</p>
    <div class="row g-3"><div class="col-md-6"><label class="form-label" for="feederLatitude">Latitude</label><input id="feederLatitude" type="number" name="feederLatitude" step="any" value="{{user.feeder.latitude}}" class="form-control"></div><div class="col-md-6"><label class="form-label" for="feederLongitude">Longitude</label><input id="feederLongitude" type="number" name="feederLongitude" step="any" value="{{user.feeder.longitude}}" class="form-control"></div></div>
  </section>
  {{/if}}

  <div class="settings-actions"><button class="btn btn-primary" type="submit">Save changes</button></div>
</form>

<script>
const themeToggle = document.getElementById("themeToggle")
themeToggle.checked = document.documentElement.dataset.theme === "dark"
themeToggle.addEventListener("change", () => {
  document.documentElement.dataset.theme = themeToggle.checked ? "dark" : "light"
  localStorage.setItem("twitchr-theme", themeToggle.checked ? "dark" : "light")
})
</script>
