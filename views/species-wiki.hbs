{{> menu id="field-study" isAuthUser=true}}

<div class="page-heading">
  <div><a class="back-link" href="/field-study"><i class="fa fa-arrow-left" aria-hidden="true"></i> Field study</a><h1>{{species.commonName}}</h1><p><em>{{species.scientificName}}</em></p></div>
</div>

<div class="species-wiki-layout">
  <aside class="species-wiki-sidebar">
    <div class="section-card species-wiki-image{{#unless species.image}} species-card-image-empty{{/unless}}">
      {{#if species.image}}<img src="{{species.image}}" alt="{{species.commonName}}">{{else}}<i class="fa fa-feather-pointed" aria-hidden="true"></i>{{/if}}
    </div>
    <div class="section-card species-facts">
      <div><span class="metric-label">Sightings</span><strong>{{species.sightings}}</strong></div>
      <div><span class="metric-label">Last seen</span><strong>{{species.lastSeen}}</strong></div>
    </div>
  </aside>

  <main class="species-wiki-content">
    <section class="section-card species-wiki-intro"><span class="wiki-initial">{{species.initial}}</span><p>{{species.description}}</p></section>
    <div class="species-wiki-columns">
      <section class="section-card species-wiki-section"><h2><i class="fa fa-location-dot" aria-hidden="true"></i> Habitat</h2><p>{{species.habitat}}</p></section>
      <section class="section-card species-wiki-section"><h2><i class="fa fa-seedling" aria-hidden="true"></i> Diet</h2><p>{{species.diet}}</p></section>
    </div>
    <section class="section-card species-wiki-section"><h2><i class="fa fa-binoculars" aria-hidden="true"></i> Behaviour</h2><p>{{species.behaviour}}</p></section>
  </main>
</div>
