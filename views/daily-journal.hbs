{{> menu id="daily-journal" isAuthUser=true}}

<div class="page-heading">
  <div><h1>Daily journal</h1><p>A day-by-day record of activity at your feeder</p></div>
</div>

<div class="journal-top-grid">
  <section class="section-card journal-calendar">
    <div class="section-header journal-section-header"><div><span class="metric-label">Activity calendar</span><h2>{{month}}</h2></div><div class="journal-calendar-controls"><a class="btn btn-outline-secondary" href="/daily-journal?month={{previousMonth}}&year={{previousYear}}" aria-label="Previous month">‹</a><a class="btn btn-outline-secondary" href="/daily-journal?month={{nextMonth}}&year={{nextYear}}" aria-label="Next month">›</a><select class="form-select journal-year-select" aria-label="Select year" onchange="location.href='/daily-journal?month={{selectedMonth}}&year=' + this.value">{{#each years}}<option value="{{this}}" {{#if (eq ../selectedYear this)}}selected{{/if}}>{{this}}</option>{{/each}}</select></div></div>
    <div class="section-body">
      <div class="journal-weekdays"><span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span><span>Sun</span></div>
      <div class="journal-days">{{#each days}}{{#if empty}}<span class="journal-day journal-day-empty"></span>{{else}}<a href="/daily-journal?day={{number}}&month={{../selectedMonth}}&year={{../selectedYear}}" class="journal-day{{#if selected}} selected{{/if}}{{#if active}} active{{/if}}{{#if today}} today{{/if}}{{#if future}} future{{/if}}" aria-label="{{label}}{{#if selected}}, selected{{/if}}{{#if birds}}, bird activity{{/if}}{{#if cats}}, cat detected{{/if}}"{{#if today}} aria-current="date"{{/if}}><span class="journal-day-number">{{number}}</span><span class="journal-day-icons">{{#if birds}}<i class="journal-dot bird-dot" aria-hidden="true"></i>{{/if}}{{#if cats}}<i class="journal-dot cat-dot" aria-hidden="true"></i>{{/if}}</span></a>{{/if}}{{/each}}</div>
      <div class="journal-legend"><span><i class="journal-dot bird-dot"></i>Bird activity</span><span><i class="journal-dot cat-dot"></i>Cat detected</span></div>
    </div>
  </section>

  <section class="section-card journal-selected-day">
    <div class="section-header"><span class="metric-label">Selected day</span><h2>{{selectedDate}}</h2></div>
    <div class="section-body journal-summary-list">
      <div class="journal-summary-item"><span class="metric-label">Bird visits</span><strong>{{summary.birds}}</strong><i class="fa fa-crow" aria-hidden="true"></i></div>
      <div class="journal-summary-item"><span class="metric-label">Species seen</span><strong>{{summary.species}}</strong><i class="fa fa-feather-pointed" aria-hidden="true"></i></div>
      <div class="journal-summary-item"><span class="metric-label">Peak activity</span><strong>{{summary.peak}}</strong><i class="fa fa-clock" aria-hidden="true"></i></div>
      <div class="journal-summary-item"><span class="metric-label">Cat detections</span><strong>{{summary.cats}}</strong><i class="fa fa-cat" aria-hidden="true"></i></div>
    </div>
  </section>
</div>

<section class="section-card journal-chart-card">
  <div class="section-header"><span class="metric-label">Hourly activity</span><h2>{{selectedDate}}</h2><p>Bird visits recorded throughout the selected day.</p></div>
  <div class="section-body journal-chart-wrap"><canvas id="journalActivityChart"></canvas></div>
</section>

<div class="journal-detail-grid">
  <section class="section-card journal-highlight"><div class="section-header"><h2><i class="fa fa-star" aria-hidden="true"></i> Today's highlight</h2></div><div class="section-body"><span class="metric-label">Most active species</span><strong>{{highlights.species}}</strong><p>{{highlights.note}}</p></div></section>
  <section class="section-card journal-species"><div class="section-header"><span class="metric-label">Species observed</span><h2>Today's species</h2></div><div class="section-body">{{#each species}}<a href="/field-study" class="journal-species-row"><span><i class="fa fa-feather-pointed" aria-hidden="true"></i>{{name}}</span><strong>{{count}}</strong></a>{{/each}}</div></section>
  <section class="section-card journal-distribution"><div class="section-header"><h2>Species distribution</h2></div><div class="section-body distribution-chart">{{> species-distribution distribution}}</div></section>
</div>

<section class="section-card journal-table-card"><div class="section-header"><span class="metric-label">Sightings table</span><h2>{{selectedDate}}</h2></div><div class="section-body"><nav><div class="nav nav-tabs" id="journal-nav-tab" role="tablist"><a class="nav-item nav-link active" data-bs-toggle="tab" href="#journal-birds" role="tab"><i class="fa fa-crow tab-icon" aria-hidden="true"></i>Birds</a><a class="nav-item nav-link" data-bs-toggle="tab" href="#journal-cats" role="tab"><i class="fa fa-cat tab-icon" aria-hidden="true"></i>Cats</a></div></nav><div class="tab-content"><div class="tab-pane show active" id="journal-birds" role="tabpanel"><div class="table-wrap"><table class="table"><thead><tr><th>Time</th><th>Species</th><th>Image</th></tr></thead><tbody>{{#each birdSightings}}<tr><td>{{time}}</td><td>{{species}}</td><td>{{#if image}}<a href="{{image}}" target="_blank" rel="noopener noreferrer">View image</a>{{else}}<span class="text-muted">No image</span>{{/if}}</td></tr>{{else}}<tr><td colspan="3">No bird sightings</td></tr>{{/each}}</tbody></table></div></div><div class="tab-pane" id="journal-cats" role="tabpanel"><div class="table-wrap"><table class="table"><thead><tr><th>Time</th><th>Image</th></tr></thead><tbody>{{#each catSightings}}<tr><td>{{time}}</td><td>{{#if image}}<a href="{{image}}" target="_blank" rel="noopener noreferrer">View image</a>{{else}}<span class="text-muted">No image</span>{{/if}}</td></tr>{{else}}<tr><td colspan="2">No cat sightings</td></tr>{{/each}}</tbody></table></div></div></div></div></section>

<script>
const journalActivity = {{{ toJson hourlyActivity }}}
const journalCatActivity = {{{ toJson catHourlyActivity }}}
const journalAccent = document.documentElement.dataset.theme === "dark" ? "#6c8cff" : "#2d6970"
const journalAccentFill = document.documentElement.dataset.theme === "dark" ? "rgba(108, 140, 255, .12)" : "rgba(45, 105, 112, .12)"
const journalWarning = document.documentElement.dataset.theme === "dark" ? "#ffbc5e" : "#c77a52"
const journalLabels = Array.from({length:24}, (_,hour) => String(hour).padStart(2,"0") + ":00")
const journalData = journalActivity.slice(0, journalLabels.length)
new Chart(document.getElementById("journalActivityChart").getContext("2d"), {
  type: "line",
  data: { labels: journalLabels, datasets: [{ label: "Birds", data: journalData, borderColor: journalAccent, backgroundColor: journalAccentFill, fill: true, tension: .35, pointBackgroundColor: journalAccent, pointRadius: 3 }, { label: "Cats", data: journalCatActivity.slice(0, journalLabels.length), borderColor: journalWarning, backgroundColor: "transparent", borderDash: [6, 4], borderWidth: 3, fill: false, tension: .35, pointBackgroundColor: journalWarning, pointBorderColor: journalWarning, pointRadius: 5 }] },
  options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: true, labels: { color: "#667477", usePointStyle: true, padding: 14 } } }, scales: { x: { grid: { display: false }, ticks: { color: "#667477" } }, y: { beginAtZero: true, ticks: { precision: 0, color: "#667477" }, grid: { color: "#e5ebe9" } } } }
})
</script>
