{{> menu id="dashboard" isAuthUser=true}}
<div class="page-heading"><div><h1>Today's feed</h1><p>Activity and moments from your feeder</p></div><div class="updated-label">{{#if latest}}Latest update {{latest.timeLabel}} · {{latest.dateLabel}}{{else}}No sightings yet{{/if}}</div></div>
<div class="metric-grid" id="statusPanel">
  <div class="metric-card"><div><div class="metric-label">Current status</div><div class="metric-value {{dashboardStats.statusClass}}">{{dashboardStats.status}}</div></div><i class="fa fa-eye metric-icon" aria-hidden="true"></i></div>
  <div class="metric-card"><div><div class="metric-label">Visits today</div><div class="metric-value">{{dashboardStats.visits}}</div></div><i class="fa fa-crow metric-icon" aria-hidden="true"></i></div>
  <div class="metric-card"><div><div class="metric-label">Cat detections</div><div class="metric-value">{{dashboardStats.cats}}</div></div><i class="fa fa-paw metric-icon" aria-hidden="true"></i></div>
  <div class="metric-card"><div><div class="metric-label">Weather</div><div class="metric-value">{{#if weather.temperature}}{{weather.temperature}}{{else}}Unavailable{{/if}}</div><div class="metric-context">{{#if weather.condition}}{{weather.condition}}{{else}}Current local conditions{{/if}}</div></div><i class="fa {{#if weather.icon}}{{weather.icon}}{{else}}fa-sun{{/if}} metric-icon" aria-hidden="true"></i></div>
</div>
<div class="feed-stack">
<section class="section-card feed-latest">
  {{#if latest}}
  <div class="feed-hero-media">{{> sighting-media latest}}</div>
  <div class="section-body feed-latest-caption"><div><span class="metric-label">Latest sighting</span><h2>{{latest.name}}</h2>{{#if latest.scientificName}}<p class="feed-scientific">{{latest.scientificName}}</p>{{/if}}</div><dl class="feed-latest-facts"><div><dt class="metric-label">Confidence</dt><dd>{{latest.confidenceLabel}}</dd></div><div><dt class="metric-label">Last seen</dt><dd>{{latest.timeLabel}}</dd><small>{{latest.dateLabel}}</small></div></dl><a class="feed-field-link" href="{{#if (eq latest.kind 'cat')}}/archive?kind=cat{{else}}/field-study{{/if}}">Learn more <span aria-hidden="true">›</span></a></div>
  {{else}}<div class="section-body feed-empty"><h2>Your next visitor will appear here</h2><p>No sightings have been recorded yet.</p></div>{{/if}}
</section>
<section><div class="feed-section-heading"><h2>Recent activity</h2><a href="/archive">View archive <span aria-hidden="true">›</span></a></div><div class="feed-recent-grid">{{#each recentActivity}}<article class="section-card feed-recent-card"><div class="feed-recent-media">{{> sighting-media}}</div><div class="section-body"><h3>{{name}}</h3><p>{{timeLabel}} · {{dateLabel}} · {{mediaLabel}}</p></div></article>{{else}}<p class="feed-empty">Recent sightings will appear here.</p>{{/each}}</div></section>
<section class="section-card"><div class="section-header"><h2>Today's activity</h2><p>Bird visits and cat detections by hour, since midnight.</p></div><div class="section-body feed-activity-chart"><canvas id="feedActivityChart" role="img" aria-label="Hourly bird and cat sightings today"></canvas><p id="feedChartFallback" hidden>Chart unavailable. Today's sightings are listed below.</p></div></section>
<section class="section-card"><div class="section-header"><h2>Sightings timeline</h2><p>Today's visits, with media you can expand to explore.</p></div><div class="section-body feed-timeline" id="dashboardTimeline">
{{#each timeline}}<article class="feed-timeline-item"><time datetime="{{timestamp}}">{{timeLabel}}</time><span class="feed-timeline-dot {{kind}}" aria-hidden="true"></span><div class="feed-timeline-content">{{#if url}}<details class="feed-sighting-details"><summary><span class="feed-timeline-title">{{name}} <span class="feed-kind {{kind}}">{{typeLabel}}</span></span><span class="feed-expand-label">View {{#if isVideo}}video{{else}}image{{/if}} <i class="fa fa-chevron-right" aria-hidden="true"></i></span></summary><div class="feed-expanded-media">{{> sighting-media}}</div><a class="feed-original" href="{{url}}" target="_blank" rel="noopener noreferrer">Open original {{#if isVideo}}video{{else}}image{{/if}} ↗</a></details>{{else}}<div class="feed-timeline-missing"><span class="feed-timeline-title">{{name}} <span class="feed-kind {{kind}}">{{typeLabel}}</span></span><span>No media recorded</span></div>{{/if}}</div></article>{{else}}<p class="feed-empty">No sightings recorded today.</p>{{/each}}
</div></section>
{{#if isAdmin}}<section class="section-card"><div class="section-header"><h2>Device controls</h2><p>Send a command to the feeder hardware.</p></div><div class="section-body controls-grid"><button class="btn btn-outline-secondary" data-feed-weather>Update weather</button><button class="btn btn-outline-secondary" data-feed-sound="insect">Insect sound</button><button class="btn btn-outline-secondary" data-feed-sound="birds">Bird sound</button><button class="btn btn-outline-secondary" data-feed-sound="water">Water sound</button><button class="btn btn-outline-warning" data-feed-sound="bark">Cat deterrent</button></div><p id="feedCommandStatus" class="feed-command-status" role="status" aria-live="polite"></p></section>{{/if}}
</div>
<script id="feed-activity-data" type="application/json">{{{activityJson}}}</script>
<div id="feed-config" data-csrf="{{csrfToken}}"></div>
<script src="/js/dashboard.js"></script>
