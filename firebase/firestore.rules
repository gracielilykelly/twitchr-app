rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function enrolled() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function member() { return enrolled() && profile().get('isFeeder', false) == false; }
    function administrator() { return member() && profile().get('isAdmin', false) == true; }
    function feeder() {
      return enrolled() && profile().get('isFeeder', false) == true
        && profile().get('ownerId', '') is string
        && get(/databases/$(database)/documents/users/$(profile().ownerId)).data.get('isAdmin', false) == true;
    }
    function feederOwner(uid) { return feeder() && profile().ownerId == uid; }
    function validPreference(p) {
      return p.keys().hasOnly(['receive', 'commTypes']) && p.receive is bool && p.commTypes is list
        && p.commTypes.size() <= 2 && p.commTypes.hasOnly(['email', 'sms']);
    }
    function validPreferences(p) {
      return p.keys().hasOnly(['bird', 'cat', 'weather'])
        && validPreference(p.bird) && validPreference(p.cat) && validPreference(p.weather);
    }
    function validLocation(p) {
      return p.keys().hasOnly(['latitude', 'longitude'])
        && p.latitude is number && p.longitude is number
        && p.latitude >= -90 && p.latitude <= 90 && p.longitude >= -180 && p.longitude <= 180;
    }
    function validLog(log) {
      return log.keys().hasOnly(['weather']) && log.weather.keys().hasOnly(['sunset', 'cold', 'hot'])
        && log.weather.get('sunset', '') is string && log.weather.get('cold', '') is string
        && log.weather.get('hot', '') is string;
    }
    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || feederOwner(uid));
      allow list, create, delete: if false;
      allow update: if member() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['firstName','lastName','email','phoneNumber','notificationSettings','feeder','notificationLogs'])
        && request.resource.data.firstName is string && request.resource.data.firstName.size() <= 200
        && request.resource.data.lastName is string && request.resource.data.lastName.size() <= 200
        && request.resource.data.phoneNumber is string && request.resource.data.phoneNumber.size() <= 200
        && request.resource.data.email == request.auth.token.email
        && validPreferences(request.resource.data.notificationSettings)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['feeder']) || (administrator() && validLocation(request.resource.data.feeder)))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['notificationLogs']) || (administrator() && validLog(request.resource.data.notificationLogs)));
      allow update: if feederOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notificationLogs'])
        && validLog(request.resource.data.notificationLogs);
    }
    match /notification_subscriptions/{uid} {
      allow read: if administrator() || feeder() || (member() && request.auth.uid == uid);
      allow create, update: if member() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email','phoneNumber','notificationSettings'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.phoneNumber == getAfter(/databases/$(database)/documents/users/$(uid)).data.phoneNumber
        && request.resource.data.notificationSettings == getAfter(/databases/$(database)/documents/users/$(uid)).data.notificationSettings
        && validPreferences(request.resource.data.notificationSettings);
      allow delete: if false;
    }
    match /bird_events/{id} { allow read: if member(); allow write: if false; }
    match /birds/{id} { allow read: if member(); allow write: if false; }
  }
}
